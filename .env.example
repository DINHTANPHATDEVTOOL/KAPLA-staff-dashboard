# Supabase Project URL (Local: http://127.0.0.1:54321 hoặc Cloud: https://your-project.supabase.co)
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anon Public Key (từ Supabase Dashboard hoặc `supabase status`)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key

# Chế độ kiểm thử nội bộ không cần Supabase Docker / Cloud (true/false)
# Khi bật true: Cho phép giả lập lưu trữ IndexedDB/LocalStorage và kiểm thử luồng auth/duyệt quyền offline
VITE_ENABLE_DEV_MOCK=false
